# ─── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Comma separated list of origins allowed to call the API with cookies.
CORS_ORIGINS=http://localhost:5173

# ─── Database ──────────────────────────────────────────────────────────────
# Local Postgres, or a free hosted one (Neon / Supabase / Render Postgres).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kaned"
# Supabase: Project Settings -> Database -> Connection string -> URI.
# Either the direct connection (port 5432) or the pooler (6543) works; with the
# pooler the app turns prepared statements off by itself.
# DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"
# TLS is used automatically for hosted databases and skipped for a local one.
# Set this only to force the decision: require | disable
# DATABASE_SSL=disable

# ─── Auth ──────────────────────────────────────────────────────────────────
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ─── Sign in with Google / Microsoft / GitHub / Facebook ──────────────────────
# A provider shows up on the sign-in screen once BOTH its ID and secret are set.
# Register this callback URL with each provider (replace <provider>):
#   development:  http://localhost:5173/api/auth/oauth/<provider>/callback
#   production:   <API_PUBLIC_URL>/api/auth/oauth/<provider>/callback
# Step-by-step for each console: README → "Đăng nhập bằng tài khoản bên thứ ba".
#
# Where the web app lives (defaults to the first CORS origin) and the API's
# address as the browser sees it (defaults to WEB_URL: in development the API
# is reached through the Vite proxy). Set both in production.
# WEB_URL=https://kaned.vercel.app
# API_PUBLIC_URL=https://kaned-api.onrender.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# common = personal + work/school accounts. A tenant ID or domain allows one school only.
MICROSOFT_TENANT=common
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ─── Cloudinary (file storage) ─────────────────────────────────────────────
# Leave empty to fall back to local disk storage in ./uploads during development.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=kaned/documents
