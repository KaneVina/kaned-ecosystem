# Base URL of the API. In development the Vite proxy forwards /api, so this
# can stay empty. In production set it to your Render URL, e.g.
#   VITE_API_URL=https://kaned-api.onrender.com
VITE_API_URL=

# OAuth client ID from https://console.cloud.google.com/apis/credentials
# Must be the same client ID the API verifies against.
VITE_GOOGLE_CLIENT_ID=
